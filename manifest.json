{
  "manifest_version": 3,
  "name": "SpoilerGuard for YouTube",
  "version": "0.6.0",
  "description": "Covers spoilery or unwanted YouTube thumbnails and titles until you choose to reveal them.",
  "homepage_url": "https://vedant-95.github.io/spoilerguard/",
  "permissions": ["storage", "contextMenus", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://raw.githubusercontent.com/vedant-95/spoilerguard/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "SpoilerGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/matcher.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["packs/*.json"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
